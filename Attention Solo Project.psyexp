        <Param val="cuePos = [(- 0.5), 0];&amp;#10;targetPos = [(- 0.5), 0];&amp;#10;if ((cueSide === &quot;left&quot;)) {&amp;#10;    cuePos = [(- 0.5), 0];&amp;#10;} else {&amp;#10;    cuePos = [0.5, 0];&amp;#10;}&amp;#10;if ((targetSide === &quot;left&quot;)) {&amp;#10;    targetPos = [(- 0.5), 0];&amp;#10;} else {&amp;#10;    targetPos = [0.5, 0];&amp;#10;}&amp;#10;targetStart = ((0.5 + 0.1) + Number.parseFloat(interval));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="cuePos = (-0.5, 0)&amp;#10;targetPos = (-0.5, 0)&amp;#10;&amp;#10;if cueSide == 'left':&amp;#10;    cuePos = (-0.5, 0)&amp;#10;else:&amp;#10;    cuePos = (0.5, 0)&amp;#10;&amp;#10;if targetSide == 'left':&amp;#10;    targetPos = (-0.5, 0)&amp;#10;else:&amp;#10;    targetPos = (0.5, 0)&amp;#10;&amp;#10;targetStart = 0.5 + 0.1 + float(interval)" valType="extendedCode" updates="constant" name="Begin Routine"/>
